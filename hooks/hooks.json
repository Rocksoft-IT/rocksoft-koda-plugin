{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/koda_hook.py\" session-start 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/koda_hook.py\" prompt 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
